{
  "name": "studio-starter",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/bundle-api.mjs",
    "bundle:api": "node scripts/bundle-api.mjs",
    "preview": "vite preview",
    "db:migrate": "node scripts/migrate.mjs",
    "test": "node --test --experimental-strip-types scripts/*.test.mjs src/core/images/*.test.ts src/core/modules/free-canvas/*.test.ts server/core/*.test.ts",
    "smoke:api": "node scripts/smoke-api.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1116.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@neondatabase/serverless": "^1.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "esbuild": "^0.28.2",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}

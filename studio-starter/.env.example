# Neon — Settings → Connection string (pooled)
DATABASE_URL=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Dominio público del bucket. Sin esto las URLs no son públicas.
R2_PUBLIC_BASE_URL=

# Admin. Ninguna de estas puede llevar prefijo VITE_: no deben llegar al browser.
ADMIN_PASSWORD=
# Distinto de ADMIN_PASSWORD. Generar: openssl rand -hex 32
ADMIN_SESSION_SECRET=
